// ====================================================================
// ملف حساب الخطأ (Error.ino)
// حساب نسبة الانحراف عن المسار باستخدام خوارزمية المتوسط المرجح (Weighted Average)
// ====================================================================

void calculateError() {
  
  // 1. تعريف المتغيرات المحلية لتجميع القراءات
  long weightedSum = 0; // مجموع (قراءة الحساس × وزنه الهندسي)
  long sum = 0;         // مجموع قراءات الحساسات الصافية

  // 2. إخفاء الحساسات الطرفية (الرادارات) عن خوارزمية التتبع
  // نصفر S1 و S10 حتى لا يتسببا بانحراف الروبوت عند المرور بجانب تقاطع (+) أو (T)
  sensorValue[0] = 0; 
  sensorValue[9] = 0;

  // 3. حلقة حساب المتوسط المرجح للخط الأسود
  for (int i = 0; i < 10; i++) {
    // نأخذ فقط الحساسات التي ترى الخط فعلياً (أعلى من العتبة) لتقليل التشويش
    if (sensorValue[i] > lineThreshold) { 
      weightedSum += (long)sensorValue[i] * sensorWeights[i];
      sum += sensorValue[i];
    }
  }

  // ====================================================================
  // 4. تقييم الحالة بناءً على النتيجة
  // ====================================================================
  
  // أ. في حال كان الخط موجوداً أسفل الروبوت
  if (sum > 0) {
    // حساب الخطأ اللحظي (موجب للانحراف يساراً، سالب للانحراف يميناً)
    currentError = (float)weightedSum / (float)sum;

    // --- حماية الـ PD (منع الصدمة التفاضلية Derivative Kick) ---
    // إذا كان الروبوت فاقداً للخط في الدورة السابقة ووجده الآن
    if (!lineWasFound) {      
      lastError = currentError; // نساوي الخطأ القديم بالجديد لمنع فرملة عكسية عنيفة
      lineWasFound = true;      // نؤكد نجاح الاستشفاء
    }

    // إرسال قيمة الخطأ الجديدة لخوارزمية الـ PD لتعديل سرعة المحركات
    calculatePD();
  } 
  
  // ب. في حال الفقدان الكلي للخط (لم يقرأ أي حساس قيمة أعلى من العتبة)
  else {
    // خط الدفاع الأخير: إذا فشلت الاستراتيجيات المخصصة (St1 إلى St6) في إنقاذ الروبوت،
    // يتم تسجيل حالة الفقدان، ويتم توجيه الروبوت للأمام أملًا في التقاط الخط لاحقاً.
    lineWasFound = false;
    forwardMotor();
  }
}
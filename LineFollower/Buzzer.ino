// ====================================================================
// ملف إدارة الطنان والتنبيهات الصوتية (Buzzer.ino)
// يحتوي على دوال إصدار النغمات للتفاعل مع المستخدم (User Feedback)
// ====================================================================

// ---------------------------------------------------------
// 1. نغمة "اكتمال قراءة الأبيض"
// الوصف: 3 صفارات قصيرة وسريعة بتردد متوسط للتأكيد
// الاستخدام: داخل الاستراتيجية 0 (المعايرة)
// ---------------------------------------------------------
void playToneWhiteDone() {
  for (int i = 0; i < 3; i++) {
    tone(buzzerPin, 2500, 80); // تشغيل نغمة بتردد 2500 هرتز لمدة 80 ملي ثانية
    
    // الانتظار لضمان وضوح التقطيع بين الصفارات 
    // (80 ملي ثانية لصوت النغمة + 80 ملي ثانية صمت تام = 160)
    delay(160); 
  }
}

// ---------------------------------------------------------
// 2. نغمة "اكتمال قراءة الأسود / انتهاء المعايرة"
// الوصف: صفارة طويلة متبوعة بنغمة حادة وقصيرة (تُشبه صوت الموافقة)
// الاستخدام: داخل الاستراتيجية 0 (المعايرة)
// ---------------------------------------------------------
void playToneCalibrationComplete() {
  // المقطع الأول: صفارة طويلة
  tone(buzzerPin, 2000, 600); // تردد 2000 هرتز لمدة 600 ملي ثانية
  delay(750);                 // انتظار (600 للنغمة + 150 ملي ثانية صمت)
  
  // المقطع الثاني: نغمة حادة للتأكيد النهائي
  tone(buzzerPin, 3000, 400); // تردد 3000 هرتز لمدة 400 ملي ثانية
  delay(400);                 // انتظار حتى تنتهي النغمة تماماً
}

// ---------------------------------------------------------
// 3. نغمة "نجاح الاتصال بالواي فاي و OTA"
// الوصف: نغمتين متتاليتين تتصاعدان في التردد (صوت الإقلاع)
// الاستخدام: تُستدعى مرة واحدة عند نجاح تشغيل الخدمات اللاسلكية
// ---------------------------------------------------------
void playToneWiFiConnected() {
  // النغمة الأولى (منخفضة)
  tone(buzzerPin, 1500, 150); 
  delay(200);                 // (150 للنغمة + 50 صمت)
  
  // النغمة الثانية (مرتفعة)
  tone(buzzerPin, 2500, 200);
  delay(250);                 // (200 للنغمة + 50 صمت)
}
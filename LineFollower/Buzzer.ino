// ==========================================
// دوال النغمات المخصصة للمعايرة والتنبيهات
// ==========================================

// 1. نغمة "تم الأبيض" (3 صفارات قصيرة وسريعة بتردد متوسط)
void playToneWhiteDone() {
  for (int i = 0; i < 3; i++) {
    tone(buzzerPin, 2500, 80); // تشغيل نغمة لمدة 80 ملي ثانية
    delay(160); // الانتظار لضمان وضوح التقطيع (80 للتشغيل + 80 صمت)
  }
}

// 2. نغمة "تم الأسود / اكتملت المعايرة" (صفارة طويلة ثم نغمة حادة)
void playToneCalibrationComplete() {
  tone(buzzerPin, 2000, 600); // صفارة طويلة بتردد 2000
  delay(750); // انتظار 600 للتشغيل + 150 صمت
  
  // نغمة حادة للتأكيد (تردد 3000 هرتز لمدة 400 مللي ثانية)
  tone(buzzerPin, 3000, 400);
  delay(400); // انتظار انتهاء النغمة
}

// 3. دالة نغمة الواي فاي (التي اتفقنا عليها مسبقاً)
void playToneWiFiConnected() {
  tone(buzzerPin, 1500, 150);
  delay(200);
  tone(buzzerPin, 2500, 200);
  delay(250);
}